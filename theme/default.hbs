<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+Telugu:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap">
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    {{!-- Beta: keep the archive out of search engines until editorial and legal review is in place. --}}
    <meta name="robots" content="noindex, nofollow">
    {{ghost_head}}
</head>
<body class="{{body_class}}">
    <a class="skip" href="#main">Skip to content</a>
    <div class="beta-bar">
        Public archive beta · All records shown are <strong>synthetic samples</strong> while the editorial and legal review process is set up.
    </div>
    {{> "header"}}
    <main id="main">
        {{{body}}}
    </main>
    {{> "footer"}}
    <script src="{{asset "js/site.js"}}" defer></script>
    {{ghost_foot}}
</body>
</html>
