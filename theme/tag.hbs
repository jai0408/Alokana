{{!< default}}
{{#tag}}
<div class="wrap">
    <header class="page-head">
        <p class="kicker"><a href="/cases/">Case database</a> · Tag</p>
        <h1>{{name}}</h1>
        {{#if description}}<p class="lede">{{description}}</p>{{/if}}
    </header>
</div>
{{/tag}}
<div class="wrap">
    {{> "category-chips"}}
    {{#if posts}}
    <div class="case-grid">
        {{#foreach posts}}
            {{#has tag="case"}}{{> "case-card"}}{{/has}}
        {{/foreach}}
    </div>
    {{#get "posts" filter="tag:{{tag.slug}}+tag:investigation" limit="10" include="tags"}}
    {{#if posts}}
    <h2 style="margin-top:48px">Investigations</h2>
    <ol class="inv-list">
        {{#foreach posts}}{{> "investigation-item"}}{{/foreach}}
    </ol>
    {{/if}}
    {{/get}}
    {{else}}
    <div class="empty"><p>Nothing has been published under this tag yet.</p></div>
    {{/if}}
    {{> "pagination"}}
</div>
