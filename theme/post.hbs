{{!< default}}
{{#post}}
{{!-- Match on slug: {{#has tag}} compares tag names, and this tag is named "Case record". --}}
{{#match primary_tag.slug "case"}}
<article class="case-record">
    <header class="case-head">
        <div class="wrap">
            <nav class="crumbs" aria-label="Breadcrumb"><a href="/cases/">Case database</a></nav>
            {{#has tag="#synthetic"}}
            <div class="synthetic" role="note"><strong>Synthetic sample record.</strong> Every party, document number, amount and date on this page is invented to demonstrate how a published case will look. It describes no real person, company or event.</div>
            {{/has}}
            <p class="kicker">{{tags from="2" to="2" autolink="false"}}</p>
            <h1>{{title}}</h1>
            {{> "status"}}
            {{> "status-detail"}}
        </div>
    </header>
    <div class="wrap case-body">
        <div class="case-content">
            {{content}}

            <aside class="covered">
                <h2>Covered in investigations</h2>
                <ul>
                {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-case-"}}
                {{#get "posts" filter="tag:{{slug}}+tag:investigation" limit="10"}}{{#foreach posts}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}{{/get}}
                {{/match}}{{/foreach}}
                </ul>
            </aside>

            <p class="small" style="margin-top:40px">Spot a factual error, or named in this record? <a href="/right-of-reply/">Request a correction or respond</a>.</p>
        </div>
        <nav class="toc" aria-label="On this page">
            <p class="kicker">On this page</p>
            <div data-toc></div>
        </nav>
    </div>
</article>
{{else}}
<article class="{{post_class}}">
    <header class="case-head">
        <div class="wrap">
            <nav class="crumbs" aria-label="Breadcrumb">
                {{#has tag="investigation"}}<a href="/investigations/">Investigations</a>{{else}}<a href="{{@site.url}}">Home</a>{{/has}}
            </nav>
            <p class="kicker">{{#if primary_tag}}{{tags from="2" to="3" separator=" · " autolink="false"}}{{/if}}</p>
            <h1 style="max-width:24ch">{{title}}</h1>
            {{#if custom_excerpt}}<p class="lede">{{custom_excerpt}}</p>{{/if}}
            <p class="small muted" style="margin:0">
                {{#if authors}}By {{authors autolink="false"}} · {{/if}}Published {{date published_at format="D MMM YYYY"}}{{#match (date updated_at format="YYYY-MM-DD") "!=" (date published_at format="YYYY-MM-DD")}} · Updated {{date updated_at format="D MMM YYYY"}}{{/match}} · {{reading_time}}
            </p>
        </div>
    </header>
    <div class="wrap inv-body">
        {{#if feature_image}}
        <figure class="inv-figure">
            <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}<figcaption class="small muted">{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
        {{/if}}
        <div class="ghost-content">
            {{content}}
        </div>

        <aside class="inv-cases">
            <h2>Case records in this investigation</h2>
            <p class="muted small">Claim-by-claim evidence, current status and right-of-reply responses for each record.</p>
            <div class="case-grid">
            {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-case-"}}
            {{#get "posts" filter="tag:{{slug}}+tag:case" limit="1" include="tags"}}{{#foreach posts}}{{> "case-card"}}{{/foreach}}{{/get}}
            {{/match}}{{/foreach}}
            </div>
        </aside>

        <p class="small muted" style="margin-top:40px">Spot an error, or named in this piece? <a href="/right-of-reply/">Request a correction or respond</a>.</p>
    </div>
</article>
{{/match}}
{{/post}}
